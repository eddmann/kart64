diff --git a/src/ship/audio/SDLAudioPlayer.cpp b/src/ship/audio/SDLAudioPlayer.cpp
index d9f1e44d..e4fc5c69 100644
--- a/src/ship/audio/SDLAudioPlayer.cpp
+++ b/src/ship/audio/SDLAudioPlayer.cpp
@@ -1,8 +1,178 @@
 #include "ship/audio/SDLAudioPlayer.h"
 #include <spdlog/spdlog.h>
+#include <algorithm>
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#include <cstdlib>
+#include <cstring>
+#endif
 
 namespace Ship {
 
+#ifdef __EMSCRIPTEN__
+// ---------------------------------------------------------------------------
+// Web backend: SharedArrayBuffer ring + AudioWorklet. No SDL audio device.
+//
+// Emscripten's SDL2 audio plays through a ScriptProcessorNode whose callback
+// runs on the browser MAIN thread. Chrome's ScriptProcessorHandler TryLocks a
+// buffer shared with that thread from the real-time audio thread and emits
+// SILENCE whenever the lock is contended — measured during races: sustained
+// key input made Chrome emit silence while SDL's queue was full and its
+// callbacks were on time. That failure is structural to ScriptProcessorNode;
+// no producer-side tuning can fix it.
+//
+// Instead: DoPlay() (called from the audio pthread, a real worker thread that
+// browser main-thread jank cannot touch) writes s16 stereo frames into a ring
+// allocated in wasm memory — which under -pthread IS a SharedArrayBuffer — and
+// an AudioWorkletProcessor running on the browser's real-time audio thread
+// reads straight out of that memory, linear-resampling 26800 -> context rate.
+// The main thread's only involvement is setup.
+//
+// Layout: mCtrl[0] = frames written (monotonic), mCtrl[1] = frames consumed
+// (monotonic, worklet-owned), mCtrl[2] = underrun count.
+// C++ release-stores the write counter after copying samples; the worklet
+// acquire-loads it (JS Atomics are seq-cst, which is at least acquire), so the
+// sample writes are visible before the counter moves. Capacity is a power of
+// two; counters wrap at 2^32 frames (~44h at 26800Hz).
+// ---------------------------------------------------------------------------
+
+static const uint32_t kRingCapFrames = 32768; // ~1.2s at 26800Hz, power of two
+
+SDLAudioPlayer::~SDLAudioPlayer() {
+    DoClose();
+}
+
+void SDLAudioPlayer::DoClose() {
+    EM_ASM({
+        if (Module.__ringAudio) {
+            try { Module.__ringAudio.ctx.close(); } catch (e) {}
+            Module.__ringAudio = null;
+        }
+    });
+    // The worklet may still be draining; leak the ring rather than free memory
+    // it could touch. It is allocated once per process.
+}
+
+bool SDLAudioPlayer::DoInit() {
+    mNumChannels = 2; // web path is stereo
+    mRing = (int16_t*)calloc((size_t)kRingCapFrames * 2, sizeof(int16_t));
+    mCtrl = (uint32_t*)calloc(8, sizeof(uint32_t));
+    if (mRing == nullptr || mCtrl == nullptr) {
+        SPDLOG_ERROR("ring audio: allocation failed");
+        return false;
+    }
+
+    // NB: EM_ASM splits macro arguments on top-level commas (braces do not
+    // protect them), so the entire JS body lives inside an IIFE's parentheses.
+    EM_ASM((function(ringPtr, ctrlPtr, cap, srcRate) {
+        var ctx = new AudioContext({ latencyHint: 'playback' });
+        Module.__ringAudio = { ctx: ctx, node: null, ringPtr: ringPtr, ctrlPtr: ctrlPtr, cap: cap };
+
+        // Autoplay policy: resume on the next user gesture if needed.
+        var resume = function() { if (ctx.state !== 'running') ctx.resume(); };
+        resume();
+        ['pointerdown', 'keydown', 'touchstart'].forEach(function(ev) {
+            document.addEventListener(ev, resume, true);
+        });
+
+        var src =
+            "class RingPlayer extends AudioWorkletProcessor {\n" +
+            "  constructor(o) { super();\n" +
+            "    const d = o.processorOptions;\n" +
+            "    this.sab = d.sab; this.ringOfs = d.ringPtr >> 1; this.ctrlOfs = d.ctrlPtr >> 2;\n" +
+            "    this.cap = d.cap; this.mask = d.cap - 1; this.srcRate = d.srcRate;\n" +
+            "    this.rd = 0; this.started = false; this.len = 0; this.mkViews();\n" +
+            "  }\n" +
+            "  mkViews() { this.h16 = new Int16Array(this.sab); this.c32 = new Uint32Array(this.sab); this.len = this.sab.byteLength; }\n" +
+            "  process(_, outputs) {\n" +
+            "    if (this.sab.byteLength !== this.len) this.mkViews();  // wasm memory grew\n" +
+            "    const o = outputs[0], L = o[0], R = o[1] || o[0], n = L.length;\n" +
+            "    const step = this.srcRate / sampleRate;\n" +
+            "    const w = Atomics.load(this.c32, this.ctrlOfs + 0);\n" +
+            "    if (!this.started) {\n" +
+            "      if (w < 4096) { L.fill(0); if (R !== L) R.fill(0); return true; }  // ~150ms prefill\n" +
+            "      this.started = true; this.rd = w - 4096;\n" +
+            "    }\n" +
+            "    const need = Math.ceil(this.rd + n * step) + 1;\n" +
+            "    if (((w - need) | 0) < 0) {  // wrap-safe signed distance\n" +
+            "      Atomics.add(this.c32, this.ctrlOfs + 2, 1);\n" +
+            "      L.fill(0); if (R !== L) R.fill(0); return true;  // hold position; producer catches up\n" +
+            "    }\n" +
+            "    let rd = this.rd;\n" +
+            "    for (let i = 0; i < n; i++) {\n" +
+            "      const i0 = Math.floor(rd), frac = rd - i0;\n" +
+            "      const a = (i0 & this.mask) * 2, b = ((i0 + 1) & this.mask) * 2;\n" +
+            "      const l0 = this.h16[this.ringOfs + a], l1 = this.h16[this.ringOfs + b];\n" +
+            "      L[i] = (l0 + (l1 - l0) * frac) / 32768;\n" +
+            "      if (R !== L) {\n" +
+            "        const r0 = this.h16[this.ringOfs + a + 1], r1 = this.h16[this.ringOfs + b + 1];\n" +
+            "        R[i] = (r0 + (r1 - r0) * frac) / 32768;\n" +
+            "      }\n" +
+            "      rd += step;\n" +
+            "    }\n" +
+            "    this.rd = rd;\n" +
+            "    Atomics.store(this.c32, this.ctrlOfs + 1, Math.floor(rd) >>> 0);\n" +
+            "    return true;\n" +
+            "  }\n" +
+            "}\n" +
+            "registerProcessor('mk64-ring', RingPlayer);\n";
+
+        var url = URL.createObjectURL(new Blob([src], { type: 'text/javascript' }));
+        ctx.audioWorklet.addModule(url).then(function() {
+            if (!Module.__ringAudio) return; // closed while loading
+            var node = new AudioWorkletNode(ctx, 'mk64-ring', {
+                numberOfInputs: 0,
+                outputChannelCount: [2],
+                processorOptions: { sab: wasmMemory.buffer, ringPtr: ringPtr, ctrlPtr: ctrlPtr, cap: cap, srcRate: srcRate }
+            });
+            node.connect(ctx.destination);
+            Module.__ringAudio.node = node;
+            out('[audio] ring/worklet backend running (' + ctx.sampleRate + 'Hz, state ' + ctx.state + ')');
+        }).catch(function(e) {
+            out('[audio] worklet init failed: ' + e);
+        });
+    })($0, $1, $2, $3), mRing, mCtrl, kRingCapFrames, this->GetSampleRate());
+
+    SPDLOG_INFO("Ring/worklet audio initialized: {} Hz -> browser context", this->GetSampleRate());
+    return true;
+}
+
+int SDLAudioPlayer::Buffered() {
+    if (mCtrl == nullptr) {
+        return 0;
+    }
+    uint32_t w = __atomic_load_n(&mCtrl[0], __ATOMIC_ACQUIRE);
+    uint32_t r = __atomic_load_n(&mCtrl[1], __ATOMIC_ACQUIRE);
+    return (int)(w - r); // frames at the game rate, same unit as the SDL queue path
+}
+
+void SDLAudioPlayer::DoPlay(const uint8_t* buf, size_t len) {
+    if (mRing == nullptr || mCtrl == nullptr) {
+        return;
+    }
+    // Same ceiling policy as the SDL path: don't run away from the reader.
+    if (Buffered() >= std::max(6000, GetDesiredBuffered() * 2)) {
+        return;
+    }
+    const int16_t* src = (const int16_t*)buf;
+    uint32_t frames = (uint32_t)(len / (2 * sizeof(int16_t)));
+    uint32_t w = __atomic_load_n(&mCtrl[0], __ATOMIC_RELAXED);
+    uint32_t r = __atomic_load_n(&mCtrl[1], __ATOMIC_ACQUIRE);
+    uint32_t space = kRingCapFrames - (w - r);
+    if (frames > space) {
+        frames = space; // never lap the reader
+    }
+    for (uint32_t i = 0; i < frames; i++) {
+        uint32_t slot = ((w + i) & (kRingCapFrames - 1)) * 2;
+        mRing[slot] = src[i * 2];
+        mRing[slot + 1] = src[i * 2 + 1];
+    }
+    __atomic_store_n(&mCtrl[0], w + frames, __ATOMIC_RELEASE);
+}
+
+#else // !__EMSCRIPTEN__
+
 SDLAudioPlayer::~SDLAudioPlayer() {
     SPDLOG_TRACE("destruct SDL audio player");
     DoClose();
@@ -59,4 +229,7 @@ void SDLAudioPlayer::DoPlay(const uint8_t* buf, size_t len) {
         SDL_QueueAudio(mDevice, buf, len);
     }
 }
+
+#endif // __EMSCRIPTEN__
+
 } // namespace Ship
