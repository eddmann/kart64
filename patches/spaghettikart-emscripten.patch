+#ifdef __EMSCRIPTEN__
+// Kart64: func_8001F394 eases camera->fieldOfView one degree a frame towards
+// the game's target and writes the result back, so anything added to it is
+// fed straight back in as next frame's starting point. The portrait widening
+// therefore has to be kept out of that loop: remember the game's own value,
+// and hand that to the easing as long as nobody else has reset the FOV since.
+static f32 sKart64FovBase[4];
+static f32 sKart64FovWritten[4];
+static f32 kart64_base_fov(Camera* camera, s32 playerIndex) {
+    if (playerIndex >= 0 && playerIndex < 4 && camera->fieldOfView == sKart64FovWritten[playerIndex]) {
