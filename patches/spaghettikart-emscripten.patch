+                file->Buffer->size(), &width, &height, nullptr, 4);
+            if (pixels && width > 0 && height > 0) {
+                entry->second.resize(88 * 88);
+                for (int y = 0; y < 88; ++y) for (int x = 0; x < 88; ++x) {
+                    int at = ((y * height / 88) * width + x * width / 88) * 4;
+                    entry->second[y * 88 + x] = pixels[at + 3] > 100 && pixels[at] > 80;
+                }
+            }
+            stbi_image_free(pixels);
+        }
+    }
+    if (entry->second.empty()) { Text(224, 120, "NO PREVIEW", TEXT_BLUE, .45f); return; }
+    // Render the archive's minimap as compact horizontal runs with native 2D
+    // primitives. No external gallery artwork or separate GPU texture is needed.
+    const int width = 88, height = 88;
+    for (int y = 0; y < height; ++y) {
+        int begin = -1;
+        for (int x = 0; x <= width; ++x) {
+            bool ink = false;
+            if (x < width) {
+                ink = entry->second[y * width + x];
+            }
+            if (ink && begin < 0) begin = x;
+            if (!ink && begin >= 0) { Box(180 + begin, 76 + y, 180 + x, 77 + y, 230, 237, 245); begin = -1; }
+        }
+    }
+}
+}
+
+extern "C" {
+const char* Kart64_GetSavePrefix(void) { return savePrefix.c_str(); }
+void Kart64_CourseMenuOpen(int32_t menu) {
+    results = false;
+    if (menu == START_MENU || menu == MAIN_MENU || menu == 0 || menu == 1 || menu == CHARACTER_SELECT_MENU || menu == 2) {
+        singleRace = false; activeCourse.clear(); SwitchRecords("");
+    }
+    if (menu != COURSE_SELECT_MENU && menu != 3) return;
+    singleRace = false; activeCourse.clear(); confirmCourse = false;
+    RefreshCourses();
+    if (!customTab || !stockCup) {
+        stockCup = GetWorld()->GetCurrentCup();
+        stockCupIndex = GetWorld()->GetCupIndex(); stockPosition = stockCup->CursorPosition;
+    }
+    if (gModeSelection == BATTLE || gPlayerCount != 1) customTab = false;
+    if (customTab) UseCustomRecords(); else SwitchRecords("");
+}
+int32_t Kart64_CustomCourseMenu(void) {
+    return gGamestate == 0 && gMenuSelection == COURSE_SELECT_MENU && customTab;
+}
+int32_t Kart64_CourseMenuInput(struct Controller* controller, uint16_t index) {
+    if (gModeSelection == BATTLE || gPlayerCount != 1) return 0;
+    if (index != 0) return customTab;
+    if (is_screen_being_faded()) return customTab;
+    uint16_t pressed = controller->buttonPressed | controller->stickPressed;
+    // Up from the cup row opens Custom, so touch users need no extra buttons.
+    if (!customTab && ((pressed & (L_TRIG | R_TRIG)) ||
+        ((pressed & U_JPAD) && gSubMenuSelection == SUB_MENU_MAP_SELECT_CUP))) {
+        stockCup = GetWorld()->GetCurrentCup(); stockCupIndex = GetWorld()->GetCupIndex();
+        stockPosition = stockCup->CursorPosition;
+        customTab = true; confirmCourse = false; UseCustomRecords();
+        play_sound2(SOUND_MENU_SELECT); return 1;
+    }
+    if (!customTab) return 0;
+    if (pressed & (L_TRIG | R_TRIG)) { Original(); play_sound2(SOUND_MENU_GO_BACK); return 1; }
+    if (pressed & B_BUTTON) {
+        if (confirmCourse) confirmCourse = false; else Original();
+        play_sound2(SOUND_MENU_GO_BACK); return 1;
+    }
+    if (!confirmCourse && !courses.empty() && (pressed & (U_JPAD | D_JPAD | L_JPAD | R_JPAD))) {
+        bool previous = pressed & (U_JPAD | L_JPAD);
+        selected = (selected + courses.size() + (previous ? -1 : 1)) % courses.size();
+        UseCustomRecords(); play_sound2(SOUND_MENU_CURSOR_MOVE);
+    }
+    if (!courses.empty() && (pressed & (A_BUTTON | START_BUTTON))) {
+        if (!confirmCourse) { confirmCourse = true; play_sound2(SOUND_MENU_SELECT); }
+        else {
+            activeCourse = courses[selected]->ResourceName;
+            TrackBrowser_SetTrack(activeCourse.c_str());
+            singleRace = gModeSelection == GRAND_PRIX;
+            gDemoMode = DEMO_MODE_INACTIVE;
+            gSubMenuSelection = SUB_MENU_MAP_SELECT_OK;
+            func_8009E1C0(); func_800CA330(0x19); play_sound2(SOUND_MENU_OK_CLICKED);
+        }
+    }
+    return 1;
+}
+void Kart64_DrawCourseBrowser(void) {
+    if (gGamestate != 0 || gMenuSelection != COURSE_SELECT_MENU || gModeSelection == BATTLE || gPlayerCount != 1) return;
+    if (customTab) {
+        Box(12, 14, 307, 209, 12, 19, 46, 240);
+        Text(160, 36, "CUSTOM COURSES", TEXT_YELLOW, .8f);
+        if (courses.empty()) Text(160, 104, "NO CUSTOM COURSES INSTALLED", TEXT_YELLOW, .5f);
+        else {
+            const auto info = courses[selected];
+            Box(20, 56, 155, 175, 27, 43, 79);
+            Text(88, 84, info->Name, TEXT_YELLOW, .56f);
+            Text(88, 106, info->Length.empty() ? "FULL CIRCUIT" : info->Length, TEXT_BLUE_GREEN_RED_CYCLE_1, .5f);
+            Text(88, 126, "3 LAPS", TEXT_YELLOW, .5f);
+            Text(88, 146, info->ResourceName == "eddmann:silverstone" ? "PIT SHORTCUT" : "CUSTOM COURSE", TEXT_YELLOW, .44f);
+            Text(224, 68, "CIRCUIT", TEXT_YELLOW, .45f);
+            DrawMap(info);
+            Text(224, 184, std::to_string(selected + 1) + " OF " + std::to_string(courses.size()), TEXT_YELLOW, .5f);
+            Text(160, 195, confirmCourse ? "A START     B BACK" : "ARROWS BROWSE     A SELECT", TEXT_YELLOW, .44f);
+            Text(160, 53, gModeSelection == TIME_TRIALS ? "TIME TRIAL" : "SINGLE RACE - 7 CPU RIVALS", TEXT_BLUE_GREEN_RED_CYCLE_1, .43f);
+        }
+    }
+    Box(10, 213, 151, 233, customTab ? 20 : 75, customTab ? 28 : 56, 35);
+    Box(168, 213, 308, 233, customTab ? 75 : 20, customTab ? 56 : 28, 35);
+    Text(80, 227, customTab ? "B ORIGINAL" : "ORIGINAL", TEXT_YELLOW, .5f);
+    if (!customTab && gSubMenuSelection == SUB_MENU_MAP_SELECT_CUP) {
+        // The stock font has no arrow glyph. Draw the Up input icon with the
+        // game's own 2D primitives alongside the Custom label.
+        for (int row = 0; row < 5; ++row)
+            Box(204 - row, 217 + row, 205 + row, 218 + row, 255, 241, 96);
+        Box(203, 222, 206, 227, 255, 241, 96);
+        Text(247, 227, "CUSTOM", TEXT_YELLOW, .5f);
+    } else {
+        Text(238, 227, customTab ? "CUSTOM" : "L R CUSTOM", TEXT_YELLOW, .5f);
+    }
+}
+int32_t Kart64_UsingCustomCourse(void) { return !activeCourse.empty(); }
+int32_t Kart64_CustomSingleRace(void) { return singleRace && !activeCourse.empty(); }
+void Kart64_OpenCustomResults(void) {
+    results = true; resultCursor = 0;
+    gRaceState = RACE_EXIT;
+    gIsGamePaused = false;
+}
+void Kart64_CustomResultsInput(void) {
+    if (!results) return;
+    uint16_t pressed = gControllers[0].buttonPressed | gControllers[0].stickPressed;
+    // Race logic can tick twice per controller read. Consume the edge so a
+    // single press moves one item rather than skipping over Change Course.
+    gControllers[0].buttonPressed = 0;
+    gControllers[0].stickPressed = 0;
+    if (pressed & U_JPAD) { resultCursor = (resultCursor + 2) % 3; play_sound2(SOUND_MENU_CURSOR_MOVE); }
+    else if (pressed & D_JPAD) { resultCursor = (resultCursor + 1) % 3; play_sound2(SOUND_MENU_CURSOR_MOVE); }
+    if (pressed & (A_BUTTON | START_BUTTON)) {
+        results = false;
+        if (resultCursor == 0) func_802903B0();
+        else if (resultCursor == 1) func_80290388();
+        else func_80290338();
+        play_sound2(SOUND_MENU_OK_CLICKED);
+    }
+}
+void Kart64_DrawCustomResults(void) {
+    if (!results || gGamestate != RACING) return;
+    Box(34, 26, 286, 210, 12, 19, 46, 235);
+    Text(160, 54, "RACE FINISHED", TEXT_YELLOW, .8f);
+    Text(160, 80, "POSITION " + std::to_string(gPlayers[0].currentRank + 1) + " OF 8", TEXT_YELLOW, .6f);
+    const char* choices[] = {"RETRY", "CHANGE COURSE", "QUIT"};
+    for (int i = 0; i < 3; ++i) {
+        if (i == resultCursor) Box(56, 94 + i * 29, 264, 117 + i * 29, 69, 53, 20);
+        Text(160, 111 + i * 29, choices[i], TEXT_YELLOW, .65f);
+    }
+    Text(160, 198, "ARROWS CHOOSE     A CONFIRM", TEXT_YELLOW, .43f);
+}
+EMSCRIPTEN_KEEPALIVE int32_t* Kart64_GetCourseBrowserState(void) {
+    static int32_t state[11];
+    state[0] = customTab; state[1] = courses.size(); state[2] = selected; state[3] = confirmCourse;
+    state[4] = !savePrefix.empty(); state[5] = singleRace; state[6] = results; state[7] = resultCursor;
+    state[8] = gModeSelection; state[9] = gCCSelection; state[10] = 0;
+    for (int i = 1; i < 8; ++i) if ((gPlayers[i].type & PLAYER_EXISTS) && (gPlayers[i].type & PLAYER_CPU)) state[10]++;
+    return state;
+}
+EMSCRIPTEN_KEEPALIVE const char* Kart64_GetCustomCourseName(void) {
+    return courses.empty() ? "" : courses[selected]->Name.c_str();
+}
+EMSCRIPTEN_KEEPALIVE int32_t Kart64_IsSilverstone(void) {
+    auto world = GetWorld();
+    return world && world->GetTrack() && world->GetTrack()->ResourceName == "eddmann:silverstone";
+}
+}
+#endif
