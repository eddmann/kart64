+std::string savePrefix, activeCourse;
+std::vector<const TrackInfo*> courses;
+Cup* stockCup = nullptr;
+size_t stockCupIndex = 0, stockPosition = 0;
+
+void RefreshCourses() {
+    courses.clear();
+    auto manager = Ship::Context::GetInstance()->GetResourceManager()->GetArchiveManager();
+    for (auto info : gTrackRegistry.GetAllInfo()) {
+        if (!info || info->Path.empty() || info->ResourceName.rfind("mk:", 0) == 0) continue;
+        // Only installed mods: the engine ships a development Harbour example.
+        auto archive = manager->GetArchiveFromFile(info->Path + "/scene.json");
+        if (!archive) continue;
+        const auto& path = archive->GetPath();
+        if (path.rfind("mods/", 0) != 0 && path.find("/mods/") == std::string::npos) continue;
+        courses.push_back(info);
+    }
+    std::sort(courses.begin(), courses.end(), [](auto a, auto b) {
+        return a->Name == b->Name ? a->ResourceName < b->ResourceName : a->Name < b->Name;
+    });
+    if (selected >= courses.size()) selected = 0;
+}
+std::string PrefixFor(const std::string& id) {
+    // Preserve the records created by the earlier Silverstone-only integration.
+    if (id == "eddmann:silverstone") return "silverstone-";
+    // Hex encoding is stable, injective and safe as a filename (no path traversal).
+    std::string prefix = "course-";
+    static const char hex[] = "0123456789abcdef";
+    for (unsigned char c : id) { prefix += hex[c >> 4]; prefix += hex[c & 15]; }
+    return prefix + "-";
+}
+void SwitchRecords(const std::string& prefix) {
+    if (savePrefix == prefix) return;
+    savePrefix = prefix;
+    // A missing EEPROM must not inherit the previously loaded course's data.
+    memset(&gSaveData, 0, sizeof(gSaveData));
+    load_save_data();
+    memset(D_8018EE10, 0, sizeof(struct_8018EE10_entry) * 2);
+    gGhostPlayerInit = 0;
+    bPlayerGhostDisabled = 1;
+    bCourseGhostDisabled = 1;
+    gControllerPak1State = BAD;
+    sControllerPak2State = BAD;
+    func_800B5F30();
+    func_800B6014();
+}
+void UseCustomRecords() {
+    if (courses.empty()) return;
+    // Stock code indexes time-trial slots by cup position. Every custom course
+    // uses slot zero in its own EEPROM/pak namespace instead of a stock record.
+    auto mushroom = static_cast<Cup*>(GetMushroomCup());
+    GetWorld()->SetCurrentCup(mushroom);
+    GetWorld()->SetCupIndex(0);
+    mushroom->SetTrack(0);
+    gCupSelection = 0; gCourseIndexInCup = 0; D_800DC540 = 0;
+    SwitchRecords(PrefixFor(courses[selected]->ResourceName));
+}
+void Original() {
+    customTab = confirmCourse = false;
+    SwitchRecords("");
+    if (stockCup) {
+        GetWorld()->SetCurrentCup(stockCup);
+        GetWorld()->SetCupIndex(stockCupIndex);
+        stockCup->SetTrack(stockPosition);
+        gCupSelection = stockCupIndex;
+        gCourseIndexInCup = stockPosition;
+        D_800DC540 = stockCupIndex;
+    }
+    gSubMenuSelection = SUB_MENU_MAP_SELECT_CUP;
+    TrackBrowser_SetTrackFromCup();
+}
+void Text(int x, int y, const std::string& text, int color = TEXT_YELLOW, float scale = .55f) {
+    // Stock glyphs support capitals; contain long metadata within the game screen.
+    std::string display = text.substr(0, 36);
+    for (char& c : display) {
+        if (c >= 'a' && c <= 'z') c -= 'a' - 'A';
+        if (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
+              c == ' ' || c == '-' || c == '.' || c == '\'')) c = ' ';
+    }
+    set_text_color(color);
