diff --git a/cmake/emscripten-deps.cmake b/cmake/emscripten-deps.cmake
new file mode 100644
index 000000000..980279a47
--- /dev/null
+++ b/cmake/emscripten-deps.cmake
@@ -0,0 +1,118 @@
+# Dependency provisioning for the Emscripten (browser/WASM) target.
+#
+# On desktop platforms these come from system packages (apt/vcpkg/brew); under
+# Emscripten every library must be compiled to wasm. SDL2 and zlib use the
+# emscripten ports (prebuild once with: embuilder build sdl2 zlib). Everything
+# else is fetched from source and redirected into the existing find_package()
+# calls via OVERRIDE_FIND_PACKAGE.
+
+include(FetchContent)
+
+# ---- SDL2 / zlib / ogg / vorbis via emscripten ports -----------------------
+add_compile_options("--use-port=sdl2" "--use-port=ogg" "--use-port=vorbis")
+add_link_options("--use-port=sdl2")
+
+# The engine is inherently threaded (resource-manager pool, audio thread):
+# full pthreads build. Requires COOP/COEP headers when serving (SharedArrayBuffer).
+add_compile_options("-pthread")
+add_link_options("-pthread" "-sPTHREAD_POOL_SIZE=16")
+
+# Persistent storage: the page mounts an IDBFS at /data (config, saves, and
+# the extracted o2r archives survive reloads).
+add_link_options("-lidbfs.js")
+
+# Torch's extraction recipe (open project files, no Nintendo content) rides
+# along as preloaded data so first-run ROM extraction can happen in-browser.
+add_link_options(
+    "SHELL:--preload-file ${CMAKE_SOURCE_DIR}/config.yml@/torch/config.yml"
+    "SHELL:--preload-file ${CMAKE_SOURCE_DIR}/yamls@/torch/yamls"
+    "SHELL:--preload-file ${CMAKE_SOURCE_DIR}/meta@/torch/meta"
+)
+
+# GLES3 -> WebGL2; the game renders through libultraship's USE_OPENGLES path.
+add_link_options(
+    "-sMIN_WEBGL_VERSION=2"
+    "-sMAX_WEBGL_VERSION=2"
+    "-sFULL_ES3=1"
+    "-sALLOW_MEMORY_GROWTH=1"
+    # ~275MB of static data (compiled-in course/audio tables); leave headroom.
+    "-sINITIAL_MEMORY=512MB"
+)
+# ASSERTIONS adds a check to every emscripten library call, on the same main
+# thread that services the audio callback. Useful while bringing the port up,
+# but it was left on in Release and shows up as frame spikes.
+add_link_options("$<IF:$<CONFIG:Release>,-sASSERTIONS=0,-sASSERTIONS=1>")
+
+set(SDL2_INCLUDE_DIRS "${EMSCRIPTEN_SYSROOT}/include/SDL2")
+if(NOT TARGET SDL2::SDL2)
+    add_library(SDL2::SDL2 INTERFACE IMPORTED)
+    set_target_properties(SDL2::SDL2 PROPERTIES
+        INTERFACE_INCLUDE_DIRECTORIES "${SDL2_INCLUDE_DIRS}")
+endif()
+
+# ---- source builds for the usual system packages ---------------------------
+# A plain set() is not enough: libzip's option(BUILD_SHARED_LIBS) runs under
+# an older policy and takes the cached value (ON by default), and a wasm
+# "shared" libzip then fails to link against the non-PIC zlib port
+# (R_WASM_MEMORY_ADDR_LEB / "recompile with -fPIC").
+set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
+
+# spdlog's bundled fmt: consteval format-string checking fails under new clang
+# (same issue cmake/TorchExternalFixes.cmake handles for AppleClang).
+add_compile_definitions(FMT_CONSTEVAL=)
+
+# libzip (o2r archives are zip files)
+set(LIBZIP_DO_INSTALL OFF CACHE BOOL "" FORCE)
+set(BUILD_TOOLS OFF CACHE BOOL "" FORCE)
+set(BUILD_REGRESS OFF CACHE BOOL "" FORCE)
+set(BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
+set(BUILD_DOC OFF CACHE BOOL "" FORCE)
+set(ENABLE_COMMONCRYPTO OFF CACHE BOOL "" FORCE)
+set(ENABLE_GNUTLS OFF CACHE BOOL "" FORCE)
+set(ENABLE_MBEDTLS OFF CACHE BOOL "" FORCE)
+set(ENABLE_OPENSSL OFF CACHE BOOL "" FORCE)
+set(ENABLE_BZIP2 OFF CACHE BOOL "" FORCE)
+set(ENABLE_LZMA OFF CACHE BOOL "" FORCE)
+set(ENABLE_ZSTD OFF CACHE BOOL "" FORCE)
+FetchContent_Declare(libzip
+    GIT_REPOSITORY https://github.com/nih-at/libzip.git
+    GIT_TAG v1.10.1
+    GIT_SHALLOW TRUE
+    OVERRIDE_FIND_PACKAGE)
+
+set(tinyxml2_BUILD_TESTING OFF CACHE BOOL "" FORCE)
+FetchContent_Declare(tinyxml2
+    GIT_REPOSITORY https://github.com/leethomason/tinyxml2.git
+    GIT_TAG 10.0.0
+    GIT_SHALLOW TRUE
+    OVERRIDE_FIND_PACKAGE)
+
+set(SPDLOG_BUILD_EXAMPLE OFF CACHE BOOL "" FORCE)
+FetchContent_Declare(spdlog
+    GIT_REPOSITORY https://github.com/gabime/spdlog.git
+    GIT_TAG v1.14.1
+    GIT_SHALLOW TRUE
+    OVERRIDE_FIND_PACKAGE)
+
+set(JSON_BuildTests OFF CACHE BOOL "" FORCE)
+FetchContent_Declare(nlohmann_json
+    GIT_REPOSITORY https://github.com/nlohmann/json.git
+    GIT_TAG v3.11.3
+    GIT_SHALLOW TRUE
+    OVERRIDE_FIND_PACKAGE)
+
+FetchContent_MakeAvailable(libzip tinyxml2 spdlog nlohmann_json)
+
+# Build-tree target names differ from the install-exported ones some
+# find_package() consumers expect; add the namespaced aliases if absent.
+if(NOT TARGET libzip::zip)
+    add_library(libzip::zip ALIAS zip)
+endif()
+if(NOT TARGET tinyxml2::tinyxml2)
+    add_library(tinyxml2::tinyxml2 ALIAS tinyxml2)
+endif()
+
+# Sources across the tree include <zip.h> without linking libzip::zip; with a
+# system libzip that comes from /usr/include, so mirror it globally here
+# (zipconf.h is generated into the libzip build dir).
+include_directories(${libzip_SOURCE_DIR}/lib ${libzip_BINARY_DIR})
