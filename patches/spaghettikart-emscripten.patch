diff --git a/src/main.c b/src/main.c
index 728d65609..ac49b06db 100644
--- a/src/main.c
+++ b/src/main.c
@@ -1,3 +1,6 @@
+#ifdef __EMSCRIPTEN__
+#include "port/kart64_courses.h"
+#endif
 #include <libultraship.h>
 #include <libultra/vi.h>
 #include <libultra/os.h>
@@ -387,12 +390,94 @@ void update_controller(s32 index) {
     controller->stickDirection = stick;
 }
 
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+
+// Touch input from the page. The browser has no way to synthesise a gamepad,
+// and synthetic key events would only ever give binary steering -- which makes
+// drifting unusable. So the page writes the pad directly: stick_x/stick_y are
+// the real analog range (-128..127), buttons is an N64 mask (A 0x8000,
+// B 0x4000, Z 0x2000, START 0x1000, R 0x0010).
+//
+// active=0 hands control straight back to the keyboard/gamepad path, so a
+// desktop browser and a phone can share one build with no mode switch.
+static s8 sTouchStickX = 0;
+static s8 sTouchStickY = 0;
+static u16 sTouchButtons = 0;
+static s32 sTouchActive = 0;
+static s32 sTouchAutoAccel = 0;
+
+// Auto-accelerate: hold A for the player, but only while a race is actually
+// being driven (not the grid countdown, where an early A is a burnout, and
+// not the menus, where A is confirm).
+EMSCRIPTEN_KEEPALIVE void Kart64_SetAutoAccel(s32 on) {
+    sTouchAutoAccel = on;
+}
+
+EMSCRIPTEN_KEEPALIVE void Kart64_SetTouchPad(s32 active, s32 stickX, s32 stickY, s32 buttons) {
+    sTouchActive = active;
+    sTouchStickX = (s8) stickX;
+    sTouchStickY = (s8) stickY;
+    sTouchButtons = (u16) buttons;
+}
+
+// Drift assist, for the page's one-thumb (Tour) controls: a held drift that
+// charges itself. MK64 charges a mini-turbo while sliding when the stick is
+// held against the turn for 18 kart updates and brought back, then 8 more
+// against and back again (func_8002A8A4 in player_controller.c). A thumb
+// holding a drift cannot do that, so while the page reports a drift held in
+// direction dir (-1 left, 1 right; 0 ends it) the stick is overridden by
+// frame: the slide's own direction while the hop lands, then two short
+// nudges against it. Counted here, in the controller read, because the game
+// counts updates (two per controller frame); a slow device stretches the
+// wall-clock time, never the count. The nudges are light and no longer than
+// they need to be (the stick filter lags about three frames, then two counts
+// a frame), because steering against the bend for long carries the kart into
+// the outside wall, which ends the slide.
+static s32 sDriftDir = 0;
+static s32 sDriftFrames = 0;
+EMSCRIPTEN_KEEPALIVE void Kart64_SetDriftAssist(s32 dir) {
+    sDriftDir = dir < 0 ? -1 : dir > 0 ? 1 : 0;
+    sDriftFrames = 0;
+}
+static s8 drift_assist_stick(s8 stick) {
+    // frames:  0..9 into the slide (the hop lands at about frame 8)
+    //         10..23 against (3 lag + 11 x 2 = 22 counts >= 18), 24..27 back,
+    //         28..36 against (3 lag + 6 x 2 = 12 counts >= 8), then back for good:
+    //         charged a little over a second after the flick.
+    s32 f = sDriftFrames++;
+    s32 against = (f >= 10 && f < 24) || (f >= 28 && f < 37);
+    if (against) {
+        return (s8) (-sDriftDir * 40);
+    }
+    s32 mag = stick < 0 ? -stick : stick;
+    return (s8) (sDriftDir * (mag > 40 ? mag : 40));
+}
+#endif
+
 void read_controllers(void) {
     OSMesg msg;
 
     osContStartReadData(&gSIEventMesgQueue);
     // osRecvMesg(&gSIEventMesgQueue, &msg, OS_MESG_BLOCK);
     osContGetReadData(gControllerPads);
+#ifdef __EMSCRIPTEN__
+    // Merge rather than replace: a bluetooth gamepad paired to the phone should
+    // still work while the touch overlay is on screen.
+    // Auto-accelerate does not wait for a first touch: the race may start with
+    // both thumbs still off the screen.
+    if (sTouchAutoAccel && gGamestate == RACING && gRaceState == RACE_IN_PROGRESS && !gIsGamePaused) {
+        gControllerPads[0].button |= A_BUTTON;
+    }
+    if (sTouchActive) {
+        gControllerPads[0].button |= sTouchButtons;
+        s8 sx = sDriftDir != 0 && !gIsGamePaused ? drift_assist_stick(sTouchStickX) : sTouchStickX;
+        if (sx != 0 || sTouchStickY != 0) {
+            gControllerPads[0].stick_x = sx;
+            gControllerPads[0].stick_y = sTouchStickY;
+        }
+    }
+#endif
     update_controller(0);
     update_controller(1);
     update_controller(2);
@@ -792,6 +877,9 @@ void race_logic_loop(void) {
     func_802A4300();
     func_800591B4();
     func_80093E20();
+#ifdef __EMSCRIPTEN__
+    Kart64_DrawCustomResults();
+#endif
 #if DVDL
     display_dvdl();
 #endif
